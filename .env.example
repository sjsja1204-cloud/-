# ───────── server/.env (서버 폴더에 복사해서 사용) ─────────
# Neon 접속 문자열 (sslmode=require 포함)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# 32자 이상 랜덤 문자열: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# 텔레그램 봇 (비워두면 알림 대신 서버 로그에만 출력)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 프론트 도메인 (CORS 허용). 여러 개면 쉼표로 구분
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
# 앞단 프록시 단계 수: 로컬/Render 단독=1, Cloudflare Pages Functions 프록시 경유=2
TRUST_PROXY=1
# 쿠키 SameSite: /api 를 같은 도메인으로 프록시하면 lax(권장), 다른 도메인에서 직접 호출하면 none
COOKIE_SAMESITE=lax

# ───────── client/.env (선택) ─────────
# API 주소. 비워두면 같은 도메인의 /api 사용 (권장: Pages Functions 프록시)
VITE_API_BASE=
