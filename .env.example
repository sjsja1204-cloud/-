# ───────── server/.env (서버 폴더에 복사해서 사용) ─────────
# Neon 접속 문자열 (sslmode=require 포함)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# 32자 이상 랜덤 문자열: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# 텔레그램 봇 (비워두면 알림 대신 서버 로그에만 출력)
TELEGRAM_BOT_TOKEN=
# Chat ID 는 관리자 > 사이트 설정 > 알림 에서도 바꿀 수 있음 (관리자 값 우선)
TELEGRAM_CHAT_ID=
# Cloudflare R2 (팝업·배너 이미지). 비워두면 server/uploads 폴더에 저장 — 로컬 개발용 (Render 는 재시작 시 지워짐)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 버킷 공개 주소 (r2.dev 주소 또는 연결한 도메인, 끝 / 없이)
R2_PUBLIC_URL=
# 프론트 도메인 (CORS 허용). 여러 개면 쉼표로 구분
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
# 앞단 프록시 단계 수: 로컬/Render 단독=1, Cloudflare Pages Functions 프록시 경유=2
TRUST_PROXY=1
# 쿠키 SameSite: /api 를 같은 도메인으로 프록시하면 lax(권장), 다른 도메인에서 직접 호출하면 none
COOKIE_SAMESITE=lax
# Cloudflare Turnstile (질문/답변 글쓰기 캡차, 무료). 둘 다 넣어야 켜짐 — 비우면 캡차 없이 honeypot·IP 제한만
# Cloudflare 대시보드 > Turnstile > 사이트 추가 (도메인: 홈페이지 주소)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 텔레그램 알림 속 관리자 링크용 홈페이지 주소 (비우면 CLIENT_ORIGIN 첫 번째)
SITE_URL=

# ───────── client/.env (선택) ─────────
# API 주소. 비워두면 같은 도메인의 /api 사용 (권장: Pages Functions 프록시)
VITE_API_BASE=
